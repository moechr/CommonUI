{
  "name": "@ki/common-ui",
  "version": "0.2.0",
  "description": "Gemeinsame React-Oberfläche für KI-Projekte: Tokens, App-Shell, Chat- und Formular-Komponenten.",
  "type": "module",
  "main": "./dist/common-ui.js",
  "module": "./dist/common-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/common-ui.js"
    },
    "./style.css": "./dist/common-ui.css"
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
